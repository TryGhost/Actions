{
  "name": "label-actions",
  "version": "0.0.0",
  "repository": "git@github.com:TryGhost/label-actions.git",
  "author": "Ghost Foundation",
  "license": "MIT",
  "main": "src/index.js",
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "scripts": {
    "build": "rm -rf dist && ncc build src/index.js -o dist",
    "dev": "echo \"Implement me!\"",
    "test": "NODE_ENV=testing vitest run --coverage",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "posttest": "pnpm lint",
    "preship": "pnpm test",
    "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then pnpm version && git push --follow-tags; fi"
  },
  "devDependencies": {
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.1.2",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "should": "13.2.3",
    "sinon": "22.1.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1"
  }
}
