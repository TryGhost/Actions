{
  "name": "label-actions",
  "version": "0.0.0",
  "repository": "git@github.com:TryGhost/label-actions.git",
  "author": "Ghost Foundation",
  "license": "MIT",
  "main": "src/index.js",
  "packageManager": "pnpm@12.21.0+sha512.66fd8278ee28935ce951792d34367ff3af5c432a2756445823029533835b8da529bbe0be5130afd56ed0713fb8789e47bad82d93bd5ae2fe54b15562d6276ef0",
  "scripts": {
    "build": "rm -rf dist && ncc build src/index.js -o dist",
    "dev": "echo \"Implement me!\"",
    "test": "NODE_ENV=testing vitest run --coverage",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "posttest": "pnpm lint",
    "preship": "pnpm test",
    "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then pnpm version && git push --follow-tags; fi"
  },
  "devDependencies": {
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.1.1",
    "oxfmt": "0.80.0",
    "oxlint": "1.95.0",
    "should": "13.2.3",
    "sinon": "22.1.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1"
  }
}
