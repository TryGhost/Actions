{
  "name": "label-actions",
  "version": "0.0.0",
  "repository": "git@github.com:TryGhost/label-actions.git",
  "author": "Ghost Foundation",
  "license": "MIT",
  "main": "src/index.js",
  "packageManager": "pnpm@12.16.1+sha512.091d1dee7927575661b25dab3c2ae31cafc1c54d6b71ed6a6600cf0c1cb10434a447eae14015f1b23e2e6bedeed79df94a932e2164d2832280dce3fb32f656d1",
  "scripts": {
    "build": "rm -rf dist && ncc build src/index.js -o dist",
    "dev": "echo \"Implement me!\"",
    "test": "NODE_ENV=testing vitest run --coverage",
    "lint": "oxlint --quiet && oxfmt --check .",
    "lint:fix": "oxlint --fix && oxfmt .",
    "format": "oxfmt .",
    "posttest": "pnpm lint",
    "preship": "pnpm test",
    "ship": "STATUS=$(git status --porcelain); echo $STATUS; if [ -z \"$STATUS\" ]; then pnpm version && git push --follow-tags; fi"
  },
  "devDependencies": {
    "@vercel/ncc": "0.45.0",
    "@vitest/coverage-v8": "5.0.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "should": "13.2.3",
    "sinon": "22.1.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/github": "9.1.1"
  }
}
