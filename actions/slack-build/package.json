{
    "name": "action-slack-build",
    "version": "0.0.1",
    "main": "index.js",
    "repository": "https://github.com/daniellockyer/action-slack-build",
    "author": "Daniel Lockyer <hi@daniellockyer.com>",
    "license": "MIT",
    "packageManager": "pnpm@10.34.5",
    "scripts": {
        "test": "NODE_ENV=testing vitest run --coverage",
        "lint": "oxlint --quiet && oxfmt --check .",
        "lint:fix": "oxlint --fix && oxfmt .",
        "format": "oxfmt .",
        "build": "rm -rf dist && ncc build"
    },
    "devDependencies": {
        "@actions/core": "3.0.1",
        "@slack/webhook": "8.0.2",
        "@vercel/ncc": "0.45.0",
        "@vitest/coverage-v8": "5.0.1",
        "oxfmt": "0.70.0",
        "oxlint": "1.85.0",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    }
}
